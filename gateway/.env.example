# LAN Gateway listen configuration
HOST=0.0.0.0
PORT=3000

# Internal Python ML engine endpoint (strictly localhost)
BACKEND_URL=http://127.0.0.1:8000

# Set to false when running the Python ML backend separately (e.g. systemd / NSSM / PyInstaller service)
AUTO_SPAWN_BACKEND=true

# Optional proxy request timeouts (milliseconds)
PROXY_TIMEOUT_MS=15000
HEAVY_PROXY_TIMEOUT_MS=120000
